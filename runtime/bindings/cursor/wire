#!/bin/bash
# cursor/wire — connects Permanence to Cursor: a sessionStart hook in the global
# ~/.cursor/hooks.json "hooks" key (answers both passive orientation and the forcing read at
# once — live-confirmed, design/cursor-binding.md §2), and Permanence's commands translated into
# Cursor's own global Skills directory (command invocation — confirmed live, including literal
# /name syntax). See design/cursor-binding.md for the confirmed mechanics this implements.
#
# The standing-instruction question is deliberately NOT answered by a second mechanism here — no
# working global rules/AGENTS.md file was found despite three real attempts, and whether
# sessionStart's own content (which already carries the standing-rule instruction) is acted on
# for unprompted mid-session updates is still open. See design/cursor-binding.md §5 item 1.
set -u
PERMA="${PERMA_DIR:-$HOME/permanence}"
BINDING_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

WIRE_FAILED=0

# hooks.json: safely MERGE the sessionStart hook (add only if absent; preserve everything else;
# back up before writing) — same idempotent-merge idiom every other binding's wire script uses.
HOOKS_JSON="$HOME/.cursor/hooks.json"
if ! python3 - "$HOOKS_JSON" "$BINDING_DIR" <<'PY'
import json, sys, os, shutil

path, binding_dir = sys.argv[1], sys.argv[2]
os.makedirs(os.path.dirname(path), exist_ok=True)
data = {}
if os.path.exists(path):
    try:
        data = json.load(open(path))
    except Exception:
        print("  hooks.json: present but unparseable — NOT touched. Add the hook by hand.")
        sys.exit(1)

session_start_cmd = f"{binding_dir}/session-start-hook.sh"
changed = False

data.setdefault("version", 1)
hooks = data.setdefault("hooks", {})

ss = hooks.get("sessionStart") or []
present = any(isinstance(h, dict) and h.get("command") == session_start_cmd for h in ss)
if not present:
    ss.append({"command": session_start_cmd, "type": "command", "timeout": 10})
    hooks["sessionStart"] = ss
    changed = True

if changed:
    if os.path.exists(path):
        shutil.copy(path, path + ".perma-bak")
    json.dump(data, open(path, "w"), indent=2)
    print("  hooks.json: sessionStart hook merged in (backup: hooks.json.perma-bak)")
else:
    print("  hooks.json: hook already present")
PY
then
  echo "  hooks.json: FAILED to configure automatically — add the hook by hand (see message above)"
  WIRE_FAILED=1
fi

# Skills: translate runtime/commands/*.md into ~/.cursor/skills/<name>/SKILL.md — confirmed
# real, confirmed globally invokable by literal /name syntax. Each command already carries a
# `description:` frontmatter field; reused directly rather than re-derived. The one command
# without frontmatter (perma-contents.md) falls back to its first heading/line.
CMD_SRC="$PERMA/runtime/commands"
SKILLS_DST="$HOME/.cursor/skills"
if ! python3 - "$CMD_SRC" "$SKILLS_DST" <<'PY'
import json, os, re, sys

cmd_src, skills_dst = sys.argv[1], sys.argv[2]

def extract_description(content):
    m = re.match(r'^---\s*\n(.*?)\n---\s*\n', content, re.DOTALL)
    if m:
        dm = re.search(r'^description:\s*(.*)$', m.group(1), re.MULTILINE)
        if dm:
            raw = dm.group(1).strip()
            if raw.startswith('"') and raw.endswith('"'):
                try:
                    return json.loads(raw)
                except Exception:
                    pass
            return raw
    for line in content.splitlines():
        line = line.strip()
        if line.startswith('#'):
            return line.lstrip('#').strip()
        if line:
            return line
    return "A Permanence command."

failed = []
for fname in sorted(os.listdir(cmd_src)):
    if not fname.endswith(".md"):
        continue
    name = fname[:-3]
    src_path = os.path.join(cmd_src, fname)
    content = open(src_path).read()
    description = extract_description(content)

    skill_dir = os.path.join(skills_dst, name)
    try:
        os.makedirs(skill_dir, exist_ok=True)
        fm_lines = ["---", f"name: {name}", f"description: {json.dumps(description)}", "---", ""]
        # Body: drop the source file's own frontmatter block if present, keep everything else.
        body = re.sub(r'^---\s*\n.*?\n---\s*\n', '', content, count=1, flags=re.DOTALL)
        with open(os.path.join(skill_dir, "SKILL.md"), "w") as f:
            f.write("\n".join(fm_lines) + body)
        print(f"  skill: {name}")
    except Exception as e:
        print(f"  skill: {name} — FAILED to write ({e})")
        failed.append(name)

if failed:
    sys.exit(1)
PY
then
  echo "  skills: FAILED to translate one or more commands (see messages above)"
  WIRE_FAILED=1
fi

exit "$WIRE_FAILED"
