#!/bin/bash
# devin/detect — exit 0 iff Devin CLI is usable on this machine. No side effects, per the
# detect/wire interface's own contract.
command -v devin >/dev/null 2>&1 && exit 0
# Its installer puts it in ~/.local/bin, which a non-login shell (a scheduled job, another tool's
# shell) may not have on PATH. Installed there still counts as here.
[ -x "$HOME/.local/bin/devin" ] && exit 0
exit 1
