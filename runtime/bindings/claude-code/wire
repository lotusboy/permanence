#!/bin/bash
# claude-code/wire — connects Permanence to Claude Code: commands (command invocation), the
# CLAUDE.md standing instruction, and the SessionStart/UserPromptSubmit hooks in settings.json
# (passive orientation + the forcing read). Migrated out of install.sh verbatim — see
# design/harness-binding-mechanism.md §2 for why Claude Code's wiring now lives here like any
# other binding instead of staying a permanent special case.
#
# Exit code: settings.json merge failure and a command-copy failure are both real wire failures.
# (Command-copy used to be non-fatal here while the newer bindings' analogous Skills-translation
# step was fatal — a real inconsistency the design doc's own "non-zero on a real failure" contract
# didn't allow; found by the 2026-09-14 Two-Pass review, harmonized to match.) A mismatched-marker
# CLAUDE.md WARN (see block-merge.sh) stays a deliberate soft warning, never a wire failure — but
# install.sh's own summary now surfaces it separately (see PERMA_ATTENTION_FILE).
set -u
PERMA="${PERMA_DIR:-$HOME/permanence}"
CMD_SRC="$PERMA/runtime/commands"
CMD_DST="$HOME/.claude/commands"
SHA=$(git -C "$PERMA" rev-parse --short HEAD 2>/dev/null || echo "unversioned")

WIRE_FAILED=0

# Commands: copy with version marker appended (Copy-on-install, NOT symlinks — installed copies
# carry a version marker; symlinked commands would track whatever ref the working tree has
# checked out).
mkdir -p "$CMD_DST"
for f in "$CMD_SRC"/*.md; do
  name=$(basename "$f")
  [ -f "$CMD_DST/$name" ] && cp "$CMD_DST/$name" "$CMD_DST/$name.perma-bak"
  if cp "$f" "$CMD_DST/$name"; then
    printf '\n<!-- installed-from: ~/permanence/runtime/commands/%s @ %s — edit the source in Permanence, then re-run ~/permanence/runtime/install.sh -->\n' "$name" "$SHA" >> "$CMD_DST/$name"
    echo "  command: $name"
  else
    echo "  command: $name — FAILED to copy"
    WIRE_FAILED=1
  fi
done

# Cleanup: remove a previously-installed command with no matching source anymore, but ONLY if it
# carries Permanence's own "installed-from" marker — never touch a user's own same-named file.
# Without this, a renamed/removed command stayed installed forever on every machine that had
# already run wire once (Two-Pass review, 2026-09-14).
for existing in "$CMD_DST"/*.md; do
  [ -f "$existing" ] || continue
  bn=$(basename "$existing")
  [ -f "$CMD_SRC/$bn" ] && continue
  # The marker must be the file's last line AND name this file: a user's copy of an installed
  # command under another name keeps the old marker text and must not be taken for ours. Moved
  # aside, never deleted (review 2026-10-11, C1).
  if tail -n 1 "$existing" 2>/dev/null | grep -qF "installed-from: ~/permanence/runtime/commands/$bn @ "; then
    mv -f "$existing" "$existing.perma-removed"
    echo "  command: $bn — no longer in runtime/commands/; moved to $bn.perma-removed"
  fi
done

# Agents: the checkers and design agents that runtime/agent-roles.json names as Permanence's own
# providers. Copied with the same installed-from marker as commands, and cleaned up the same way.
# A user's own same-named agent (no marker) is left exactly as it is and reported: the shipped
# names are plain words, so a clash is likely, and their file wins (review 2026-10-11, H3).
# An installed copy the user edited in place is kept beside the new one before it is replaced.
AGENT_SRC="$PERMA/runtime/agents"
AGENT_DST="$HOME/.claude/agents"
mkdir -p "$AGENT_DST"
for f in "$AGENT_SRC"/*.md; do
  [ -f "$f" ] || continue
  name=$(basename "$f")
  if [ -f "$AGENT_DST/$name" ]; then
    if ! tail -n 1 "$AGENT_DST/$name" | grep -qF "installed-from: ~/permanence/runtime/agents/$name @ "; then
      echo "  agent: $name — ATTENTION: you already have your own agent with this name; left as it is, Permanence's not installed"
      continue
    fi
    if ! { cat "$f"; printf '\n'; } | cmp -s - <(sed '$d' "$AGENT_DST/$name"); then
      keep="$AGENT_DST/$name.perma-bak"
      [ -e "$keep" ] && keep="$keep.$(date +%Y%m%d%H%M%S)"
      cp "$AGENT_DST/$name" "$keep"
      echo "  agent: $name — your edits to the installed copy are kept in $(basename "$keep")"
    fi
  fi
  if cp "$f" "$AGENT_DST/$name"; then
    printf '\n<!-- installed-from: ~/permanence/runtime/agents/%s @ %s — edit the source in Permanence, then re-run ~/permanence/runtime/install.sh -->\n' "$name" "$SHA" >> "$AGENT_DST/$name"
    echo "  agent: $name"
  else
    echo "  agent: $name — FAILED to copy"
    WIRE_FAILED=1
  fi
done
for existing in "$AGENT_DST"/*.md; do
  [ -f "$existing" ] || continue
  bn=$(basename "$existing")
  [ -f "$AGENT_SRC/$bn" ] && continue
  if tail -n 1 "$existing" 2>/dev/null | grep -qF "installed-from: ~/permanence/runtime/agents/$bn @ "; then
    mv -f "$existing" "$existing.perma-removed"
    echo "  agent: $bn — no longer in runtime/agents/; moved to $bn.perma-removed"
  fi
done

# Skills: the method skills in runtime/skills/ (one folder each, holding a SKILL.md). Installed the
# way agents are: an installed-from marker on the last line of SKILL.md, a user's own same-named skill
# (no marker) left exactly as it is, and an installed copy the user edited kept before it is replaced.
# One difference from agents: a kept or retired copy can NOT stay inside ~/.claude/skills/, because
# every folder there holding a SKILL.md is loaded as a skill and would appear twice. They go to
# ~/.claude/skills-perma-bak/ and ~/.claude/skills-perma-removed/ instead. Claude Code only for now.
SKILL_SRC="$PERMA/runtime/skills"
SKILL_DST="$HOME/.claude/skills"
SKILL_KEEP="$HOME/.claude/skills-perma-bak"
SKILL_GONE="$HOME/.claude/skills-perma-removed"
mkdir -p "$SKILL_DST"
for d in "$SKILL_SRC"/*/; do
  [ -f "$d/SKILL.md" ] || continue
  name=$(basename "$d")
  dst="$SKILL_DST/$name"
  mark="installed-from: ~/permanence/runtime/skills/$name @ "
  if [ -d "$dst" ]; then
    if ! tail -n 1 "$dst/SKILL.md" 2>/dev/null | grep -qF "$mark"; then
      echo "  skill: $name — ATTENTION: you already have your own skill with this name; left as it is, Permanence's not installed"
      continue
    fi
    edited=0
    { cat "$d/SKILL.md"; printf '\n'; } | cmp -s - <(sed '$d' "$dst/SKILL.md") || edited=1
    diff -rq -x SKILL.md "$d" "$dst" >/dev/null 2>&1 || edited=1
    mkdir -p "$SKILL_KEEP"
    if [ "$edited" -eq 1 ]; then
      keep="$SKILL_KEEP/$name.$(date +%Y%m%d%H%M%S)"
      mv "$dst" "$keep"
      echo "  skill: $name — your edits to the installed copy are kept in ~/.claude/skills-perma-bak/$(basename "$keep")"
    else
      mv "$dst" "$(mktemp -d)/"
    fi
  fi
  if cp -R "${d%/}" "$dst"; then
    printf '\n<!-- installed-from: ~/permanence/runtime/skills/%s @ %s — edit the source in Permanence, then re-run ~/permanence/runtime/install.sh -->\n' "$name" "$SHA" >> "$dst/SKILL.md"
    echo "  skill: $name"
  else
    echo "  skill: $name — FAILED to copy"
    WIRE_FAILED=1
  fi
done
for existing in "$SKILL_DST"/*/; do
  [ -f "$existing/SKILL.md" ] || continue
  bn=$(basename "$existing")
  [ -f "$SKILL_SRC/$bn/SKILL.md" ] && continue
  if tail -n 1 "$existing/SKILL.md" 2>/dev/null | grep -qF "installed-from: ~/permanence/runtime/skills/$bn @ "; then
    mkdir -p "$SKILL_GONE"
    mv "${existing%/}" "$SKILL_GONE/$bn.$(date +%Y%m%d%H%M%S)"
    echo "  skill: $bn — no longer in runtime/skills/; moved to ~/.claude/skills-perma-removed/"
  fi
done

# CLAUDE.md: manage ONLY the delimited Permanence block, never the rest of a file we don't own.
source "$PERMA/runtime/lib/block-merge.sh"
CMD_MD="$HOME/.claude/CLAUDE.md"
BLOCK_SRC="$PERMA/runtime/claude-md-block.md"
if _perma_block_merge "$CMD_MD" "$BLOCK_SRC"; then
  echo "  CLAUDE.md: Permanence block refreshed"
fi

# settings.json: safely MERGE the SessionStart + UserPromptSubmit hooks + ~/permanence permission
# (add only if absent; preserve everything else; back up before writing).
SETTINGS="$HOME/.claude/settings.json"
if command -v python3 >/dev/null 2>&1; then
  if ! python3 - "$SETTINGS" "$PERMA" <<'PY'
import json, sys, os, shutil
path, perma = sys.argv[1], sys.argv[2]
os.makedirs(os.path.dirname(path), exist_ok=True)
data = {}
if os.path.exists(path):
    try:
        data = json.load(open(path))
    except Exception:
        print("  settings.json: present but unparseable — NOT touched. Add the hook + permission by hand.")
        sys.exit(1)
cmd = f"{perma}/runtime/session-start.sh"
changed = False
try:
    ad = data.setdefault("permissions", {}).setdefault("additionalDirectories", [])
    if perma not in ad:
        ad.append(perma); changed = True
    ss = data.setdefault("hooks", {}).setdefault("SessionStart", [])
    present = any(isinstance(e, dict) and any(h.get("command") == cmd for h in e.get("hooks", [])) for e in ss)
    if not present:
        ss.append({"hooks": [{"type": "command", "command": cmd, "timeout": 10}]}); changed = True
    # UserPromptSubmit: session-load — RELIABLE per-session context auto-load (SessionStart context
    # is passive; this fires on the user's first prompt so the model actually reads the stream).
    # Core, so auto-wired (unlike events, which is opt-in).
    cmd_load = f"{perma}/runtime/session-load.sh"
    ups = data.setdefault("hooks", {}).setdefault("UserPromptSubmit", [])
    if not any(isinstance(e, dict) and any(h.get("command") == cmd_load for h in e.get("hooks", [])) for e in ups):
        ups.insert(0, {"hooks": [{"type": "command", "command": cmd_load, "timeout": 10}]}); changed = True
    # Agent roles (runtime/agent-roles.json): enforce each role's model, prompt and run record on
    # every Agent dispatch, cap what a role's agent spawns itself, and flag newly installed agents
    # once at session start. Core, so auto-wired. The script fails open.
    roles = f"{perma}/runtime/agent-roles.py"
    for event, matcher, command in (("PreToolUse", "Agent", roles), ("SubagentStop", None, roles),
                                    ("SessionStart", None, f"{roles} --check-new")):
        lst = data["hooks"].setdefault(event, [])
        if not any(isinstance(e, dict) and any(h.get("command") == command for h in e.get("hooks", [])) for e in lst):
            entry = {"hooks": [{"type": "command", "command": command, "timeout": 10}]}
            if matcher:
                entry["matcher"] = matcher
            lst.append(entry); changed = True
except (AttributeError, TypeError):
    print("  settings.json: present but has an unexpected shape under an existing key (e.g. \"hooks.SessionStart\" isn't a list) — NOT touched. Add the hook + permission by hand.")
    sys.exit(1)
if changed:
    if os.path.exists(path): shutil.copy(path, path + ".perma-bak")
    json.dump(data, open(path, "w"), indent=2)
    print("  settings.json: SessionStart + session-load (auto context) + agent-roles hooks + ~/permanence permission merged in (backup: settings.json.perma-bak)")
else:
    print("  settings.json: hook + permission already present")
PY
  then
    echo "  settings.json: FAILED to configure automatically — add the hook + permission by hand (see message above)"
    WIRE_FAILED=1
  fi
else
  cat <<SETTINGS
  settings.json: python3 not found — add these by hand to ~/.claude/settings.json (MERGE, don't overwrite):
      "permissions": { "additionalDirectories": ["$PERMA"] },
      "hooks": {
        "SessionStart": [ { "hooks": [ { "type": "command", "command": "$PERMA/runtime/session-start.sh", "timeout": 10 } ] } ],
        "UserPromptSubmit": [ { "hooks": [ { "type": "command", "command": "$PERMA/runtime/session-load.sh", "timeout": 10 } ] } ]
      }
SETTINGS
fi

# Repo hooks: the ops-ledger post-commit hook, in each repository whose binding says it is owned.
# Writes only the local, uncommitted .git/hooks folder, and never a hook it did not write.
# Needs python3; without it the step is skipped, as the settings.json step above is (review M2).
if command -v python3 >/dev/null 2>&1; then
  "$PERMA/runtime/repo-hooks.sh" || WIRE_FAILED=1
else
  echo "  repo hooks: python3 not found — skipped"
fi

exit "$WIRE_FAILED"
